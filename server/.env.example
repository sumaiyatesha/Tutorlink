# ==============================================================================
# TutorLink Backend - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env":
#    cp .env.example .env
# 2. Replace the placeholder values below with your own actual secret keys.
# 3. DO NOT commit your real ".env" file to GitHub.
# ==============================================================================

# Django Secret Key (Generate a random string for production)
SECRET_KEY=your-django-secret-key-here

# Debug Mode (Set to False in production)
DEBUG=True

# Google Gemini API Key for AI features (Post Generator, Matching Assistant)
GEMINI_API_KEY=your-gemini-api-key-here
