# ==============================================================================
# TutorLink - Example Environment Variables Template
# ==============================================================================
# Copy this file to server/.env (or .env) and fill in your actual values:
#
#   cp .env.example server/.env
#
# DO NOT commit real secrets or .env files to GitHub.
# ==============================================================================

# Django Secret Key (cryptographic signing)
SECRET_KEY=your-django-secret-key-here

# Debug Mode (True for local development, False for production)
DEBUG=True

# Google Gemini API Key (for TutorLink AI features)
GEMINI_API_KEY=your-gemini-api-key-here

